# Copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=founder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=open_founder
DATABASE_URL=postgresql://founder:change-me@localhost:5432/open_founder?schema=public

# API auth: first-run bootstrap key (>=24 chars) mapped to a Business id created by `npm run db:seed`
BOOTSTRAP_API_KEY=
BOOTSTRAP_BUSINESS_ID=
RATE_LIMIT_PER_MINUTE=60
BUSINESS_STATE_CODE=32

# Payments: direct-upi | razorpay | cashfree | phonepe (non-direct providers are adapter stubs; add the official SDK)
PAYMENT_PROVIDER=direct-upi
UPI_VPA=yourbusiness@bank
UPI_PAYEE_NAME=Your Business
PAYMENT_WEBHOOK_SECRET=
# IMAP bank-alert observer (stub)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Messaging: console | waha | whatsapp-cloud
MESSAGING_PROVIDER=console
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# AI: any OpenAI-compatible endpoint (blank = offline fallback). e.g. http://ollama:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
